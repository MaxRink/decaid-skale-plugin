{
  "id": "skale.reaplugin",
  "name": "Skale Scale",
  "author": "Maximilian Rink and Decaid contributors",
  "description": "Opt-in Skale BLE scale driver using the Decaid host runtime.",
  "version": "0.2.1",
  "apiVersion": 1,
  "permissions": ["transport.ble", "api", "pluginStorage"],
  "drivers": [{
    "id": "skale",
    "type": "scale",
    "capabilities": ["battery", "tare", "timerControl", "displayControl"],
    "ble": {"match": {"serviceUuids": ["0000ff08-0000-1000-8000-00805f9b34fb"]}},
    "surfaces": [{"id": "settings", "role": "settings", "endpoint": "device-settings"}]
  }],
  "settings": {},
  "api": [{"id": "device-settings", "type": "http", "data": {}}]
}
